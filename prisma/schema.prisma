// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  PUBLISHED
  MATCHED
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  type               String // "brand" or "manufacturer"
  company            String?
  avatar             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  capabilities       String[] // e.g., ["CNC Machining", "3D Printing"]
  certifications     String[] // e.g., ["ISO 9001", "CE Marking"]
  minOrderQuantity   Int? // Minimum order quantity
  maxOrderQuantity   Int? // Maximum order quantity
  productionCapacity Int? // Monthly production capacity
  verified           Boolean  @default(false)
  locations          String[] // Manufacturing locations
  industries         String[] // Industries served
  description        String? // This field is optional

  // JSON fields for detailed storage
  capabilityDetails    Json? // Detailed capability information
  certificationDetails Json? // Detailed certification information

  // Additional fields
  website       String?
  foundedYear   Int?
  employeeCount String? // e.g., "11-50"
  metadata      Json? // Additional metadata

  // Relationships
  briefs           Brief[]
  proposals        Proposal[]
  sentMessages     Message[]  @relation("sentMessages")
  receivedMessages Message[]  @relation("receivedMessages")

  @@index([type])
  @@index([email])
}

model Brief {
  id          String @id @default(cuid())
  title       String
  description String
  category    String
  budget      Int
  quantity    Int
  status      Status
  brandId     String
  brand       User   @relation(fields: [brandId], references: [id])

  proposals Proposal[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([category])
}

model Proposal {
  id             String         @id @default(cuid())
  message        String
  price          Int
  timeline       Int // days
  status         ProposalStatus // pending, accepted, rejected
  briefId        String
  brief          Brief          @relation(fields: [briefId], references: [id])
  manufacturerId String
  manufacturer   User           @relation(fields: [manufacturerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([briefId])
  @@index([manufacturerId])
  @@index([status])
}

model Message {
  id         String  @id @default(cuid())
  content    String
  senderId   String
  sender     User    @relation("sentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User    @relation("receivedMessages", fields: [receiverId], references: [id])
  read       Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([createdAt])
}
