generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String                    @id @default(cuid())
  email                          String                    @unique
  name                           String
  type                           UserType
  avatar                         String?
  company                        String?
  website                        String?
  preferredCategories            String[]                  @default([])
  description                    String?
  capabilities                   String[]                  @default([])
  certifications                 String[]                  @default([])
  minOrderQuantity               Int?
  maxOrderQuantity               Int?
  productionCapacity             Int?
  locations                      String[]                  @default([])
  industries                     String[]                  @default([])
  verified                       Boolean                   @default(false)
  capabilityDetails              Json?
  certificationDetails           Json?
  metadata                       Json?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  Message_Message_senderIdToUser Message[]                 @relation("Message_senderIdToUser")
  Message_Message_userIdToUser   Message[]                 @relation("Message_userIdToUser")
  participants                   Participant[]
  BriefBookmarks                 BriefBookmarks[]
  aiAssistantLogs                AiAssistantLog[]
  bookmarks                      Bookmark[]
  createdBriefs                  Brief[]                   @relation("BrandBriefs")
  receivedBriefs                 Brief[]                   @relation("ManufacturerBriefs")
  userNotifications              Notification[]            @relation("UserNotifications")
  notifications                  Notification[]            @relation("SentNotifications")
  receivedProposals              Proposal[]                @relation("BrandProposals")
  sentProposals                  Proposal[]                @relation("ManufacturerProposals")
  userNotificationSettings       UserNotificationSettings?
  User_A                         User[]                    @relation("ManufacturerBookmarks")
  User_B                         User[]                    @relation("ManufacturerBookmarks")

  @@index([type])
  @@index([email])
  @@index([verified])
  @@index([createdAt])
}

model Brief {
  id                    String           @id @default(cuid())
  title                 String
  description           String
  aiEnhancedDescription String?
  category              String
  quantity              Int
  budget                Float
  budgetRangeMin        Float?
  budgetRangeMax        Float?
  timelineDays          Int?
  location              String?
  requirements          Json?
  attachments           String[]
  status                BriefStatus      @default(DRAFT)
  eligibilityScore      Int?
  proposalsCount        Int              @default(0)
  viewsCount            Int              @default(0)
  aiSuggestions         Json?
  bestProposalId        String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  publishedAt           DateTime?
  expiresAt             DateTime?
  brandId               String
  manufacturerId        String?
  conversationId        String?          @unique
  BriefBookmarks        BriefBookmarks[]
  aiAssistantLogs       AiAssistantLog[]
  bookmarks             Bookmark[]
  brand                 User             @relation("BrandBriefs", fields: [brandId], references: [id])
  conversation          Conversation?    @relation(fields: [conversationId], references: [id])
  manufacturer          User?            @relation("ManufacturerBriefs", fields: [manufacturerId], references: [id])
  notifications         Notification[]
  proposals             Proposal[]

  @@index([brandId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([budget])
  @@map("briefs")
}

model Proposal {
  id                String           @id @default(cuid())
  message           String
  price             Float
  currency          String           @default("USD")
  timelineDays      Int
  terms             Json?
  attachments       String[]
  status            ProposalStatus   @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  decidedAt         DateTime?
  counterPrice      Float?
  counterTimeline   Int?
  counterMessage    String?
  counterTerms      Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  briefId           String
  manufacturerId    String
  brandId           String
  counterProposalId String?
  conversationId    String?          @unique
  aiAssistantLogs   AiAssistantLog[]
  notifications     Notification[]
  brand             User             @relation("BrandProposals", fields: [brandId], references: [id])
  brief             Brief            @relation(fields: [briefId], references: [id], onDelete: Cascade)
  conversation      Conversation?    @relation(fields: [conversationId], references: [id])
  counterProposal   Proposal?        @relation("CounterProposals", fields: [counterProposalId], references: [id])
  originalProposal  Proposal[]       @relation("CounterProposals")
  manufacturer      User             @relation("ManufacturerProposals", fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@index([briefId])
  @@index([manufacturerId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@map("proposals")
}

model Conversation {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  title         String?
  briefId       String?        @unique
  proposalId    String?        @unique
  lastMessageAt DateTime?
  Message       Message[]
  participants  Participant[]
  brief         Brief?
  notifications Notification[]
  proposal      Proposal?

  @@index([lastMessageAt])
}

model Participant {
  id             String       @id @default(cuid())
  userId         String
  userRole       UserType
  conversationId String
  lastReadAt     DateTime     @default(now())
  lastTypingAt   DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId, lastReadAt])
  @@index([conversationId, lastTypingAt])
}

model Bookmark {
  id             String   @id @default(cuid())
  userId         String
  manufacturerId String?
  briefId        String?
  createdAt      DateTime @default(now())
  brief          Brief?   @relation(fields: [briefId], references: [id])
  manufacturer   User?    @relation(fields: [manufacturerId], references: [id])

  @@unique([userId, manufacturerId])
  @@unique([userId, briefId])
  @@map("bookmarks")
}

model AiAssistantLog {
  id         String    @id @default(cuid())
  prompt     String
  response   String
  metadata   Json
  model      String    @default("gemini-2.0-flash")
  userId     String
  briefId    String?
  proposalId String?
  createdAt  DateTime  @default(now())
  brief      Brief?    @relation(fields: [briefId], references: [id])
  proposal   Proposal? @relation(fields: [proposalId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([briefId])
  @@index([proposalId])
  @@map("ai_assistant_logs")
}

model Notification {
  id             String               @id @default(cuid())
  type           NotificationType
  title          String
  message        String
  metadata       Json?
  priority       NotificationPriority @default(MEDIUM)
  recipientId    String
  senderId       String?
  briefId        String?
  proposalId     String?
  conversationId String?
  isRead         Boolean              @default(false)
  isArchived     Boolean              @default(false)
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  expiresAt      DateTime?
  brief          Brief?               @relation(fields: [briefId], references: [id])
  conversation   Conversation?        @relation(fields: [conversationId], references: [id])
  proposal       Proposal?            @relation(fields: [proposalId], references: [id])
  recipient      User                 @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender         User?                @relation("SentNotifications", fields: [senderId], references: [id])

  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
  @@index([recipientId, isArchived])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}

model UserNotificationSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  emailProposals    Boolean  @default(true)
  emailMessages     Boolean  @default(true)
  emailSystem       Boolean  @default(true)
  emailMarketing    Boolean  @default(false)
  pushProposals     Boolean  @default(true)
  pushMessages      Boolean  @default(true)
  pushSystem        Boolean  @default(true)
  inAppProposals    Boolean  @default(true)
  inAppMessages     Boolean  @default(true)
  inAppSystem       Boolean  @default(true)
  quietHoursStart   Int?     @default(22)
  quietHoursEnd     Int?     @default(8)
  quietHoursEnabled Boolean  @default(false)
  dailyDigest       Boolean  @default(true)
  weeklyDigest      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model Message {
  id                          String       @id @default(cuid())
  content                     String?
  type                        MessageType  @default(TEXT)
  fileUrl                     String?
  fileName                    String?
  fileSize                    Int?
  fileType                    String?
  isEdited                    Boolean      @default(false)
  isDeleted                   Boolean      @default(false)
  senderId                    String
  conversationId              String
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @default(now())
  userId                      String?
  Conversation                Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User_Message_senderIdToUser User         @relation("Message_senderIdToUser", fields: [senderId], references: [id], onDelete: Cascade)
  User_Message_userIdToUser   User?        @relation("Message_userIdToUser", fields: [userId], references: [id])

  @@index([conversationId, createdAt])
  @@index([conversationId, isDeleted])
  @@index([createdAt])
  @@index([senderId])
}

model BriefBookmarks {
  A      String
  B      String
  briefs Brief  @relation(fields: [A], references: [id], onDelete: Cascade)
  User   User   @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_BriefBookmarks_AB_pkey")
  @@index([B], map: "_BriefBookmarks_B_index")
  @@map("_BriefBookmarks")
}

enum UserType {
  BRAND
  MANUFACTURER
  ADMIN
}

enum BriefStatus {
  DRAFT
  PUBLISHED
  MATCHED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEGOTIATION
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
  EXPIRED
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
  PROPOSAL_UPDATE
}

enum NotificationType {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PROPOSAL_COUNTERED
  BRIEF_PUBLISHED
  BRIEF_MATCHED
  NEW_MESSAGE
  MENTION
  SYSTEM_ALERT
  PAYMENT_RECEIVED
  PROJECT_UPDATE
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
